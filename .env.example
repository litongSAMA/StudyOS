# StudyOS 环境变量样例
#
# 用法：
#   1) 复制为项目根目录下的 .env：   cp .env.example .env
#   2) 按需填写；不需要大模型 Key 也能完整演示（内置离线引擎）
#   3) .env 已被 .gitignore 忽略，请勿把真实 Key 提交到版本库
#
# 说明：以下变量名与实现严格一致，取自 backend/app/config.py 的 _apply_env()。
#       除本文件列出的变量外，AI 配置也可以在界面「设置 → AI 配置」里填写并存入数据库，
#       优先级为：数据库运行时配置 > 环境变量 > 内置默认值。
#       注意：本项目不会自动读取 .env 文件，请在启动前把它导出到环境变量
#       （Windows 可用 scripts\start.bat 前 set，macOS/Linux 可用 `set -a; . ./.env; set +a`），
#       或直接在界面设置页填写 —— 后者更适合不熟悉环境变量的使用者。

# ---------- 大模型（OpenAI 兼容协议：DeepSeek / OpenAI / 硅基流动 / 智谱 / Ollama 均可）----------
# 留空则全部走内置离线引擎，功能可演示，无需联网、无需 Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30

# ---------- 语义检索 embedding（OpenAI 兼容 /embeddings 接口）----------
# 留空则自动使用内置离线 TF-IDF 向量；指向本地 Ollama 时会自动复用其 embedding
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-m3
EMBED_TIMEOUT=30
EMBED_AUTO_OLLAMA=true

# ---------- 数据目录 ----------
# 默认 backend/data；DB_PATH 不填时自动跟随 DATA_DIR
# DATA_DIR=
# DB_PATH=
# VAPID_KEYS_FILE=

# ---------- 解析管线 ----------
# OCR 依赖缺失时会自动降级，无需手动关闭
OCR_ENABLED=true

# ---------- Web Push（DDL 提醒）----------
VAPID_SUBJECT=mailto:studyos@localhost
PUSH_TICK_SECONDS=60

# ---------- 安全开关 ----------
# 同步令牌等敏感信息默认只允许本机 loopback 访问；
# 仅在确知风险时开启（允许反向代理/远程访问读取管理类信息）
ALLOW_REMOTE_ADMIN=false

# ---------- 前端产物目录（后端单端口托管前端时使用）----------
# 默认 <项目根>/web/dist；手机端界面可指向 mobile/dist
# WEB_DIST=

# ---------- 测试专用（仅 CI / 受限环境需要）----------
# 指定测试临时库根目录；不设则用系统临时目录
# STUDYOS_TEST_TMP=
